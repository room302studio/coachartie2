{
  "name": "@coachartie/artie",
  "version": "1.1.0",
  "type": "module",
  "description": "Coach Artie: the engine (capabilities/HTTP API) and gateway (Discord bot) as one package, one process (wave 9+)",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/artie/tests --exclude 'packages/artie/tests/integration/**'",
    "test:integration": "vitest run --root ../.. packages/artie/tests/integration",
    "dev": "tsx watch src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "@supabase/supabase-js": "^2.49.4",
    "@turf/turf": "^6.5.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "axios": "^1.9.0",
    "better-sqlite3": "^12.4.6",
    "bullmq": "^5.1.0",
    "chance": "^1.1.13",
    "cheerio": "^1.0.0",
    "date-fns": "^3.3.1",
    "date-fns-tz": "^3.2.0",
    "discord.js": "^14.18.0",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.44.7",
    "eslint": "^9.29.0",
    "express": "^4.18.2",
    "fast-xml-parser": "^4.5.1",
    "form-data": "^4.0.0",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "html-entities": "^2.6.0",
    "ioredis": "^5.3.2",
    "marked": "^17.0.0",
    "mathjs": "^14.0.0",
    "metro-savefile-doctor": "github:ejfox/metro-savefile-doctor#main",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.9.8",
    "openai": "^4.91.1",
    "prom-client": "^15.1.3",
    "sql.js": "^1.13.0",
    "uuid": "^11.1.0",
    "winston": "^3.11.0",
    "winston-loki": "6.0.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/chance": "^1.1.7",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/node-fetch": "^2.6.12",
    "@types/nodemailer": "^6.4.14",
    "@types/sql.js": "^1.4.9",
    "drizzle-kit": "^0.31.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
