{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["pm2", "ffmpeg", "sqlite3"],
  "workspaces": {
    ".": {
      "entry": [
        "ecosystem.config.cjs",
        "scripts/*.ts",
        "tools/*.ts",
        "packages/discord/register-commands.ts"
      ]
    },
    "packages/artie": {
      "entry": ["src/engine/metro-saves/child.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  }
}
